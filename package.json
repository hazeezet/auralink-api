{
  "name": "backend",
  "version": "1.0.0",
  "description": "busha Backend Service",
  "main": "dist/server.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "dev": "nodemon",
    "clean": "node -e \"require('fs').rmSync('dist', {recursive: true, force: true})\"",
    "build": "pnpm run clean && tsc",
    "start": "node dist/server.js",
    "test": "ts-mocha -p test/tsconfig.json -t 10000 \"test/**/*.test.ts\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "migrate": "node script/migrations.mjs apply",
    "migrate:list": "node script/migrations.mjs list",
    "migrate:status": "node script/migrations.mjs list",
    "migrate:plan": "node script/migrations.mjs plan",
    "migrate:new": "node script/migrations.mjs new",
    "table:clear": "node script/clear-table.mjs"
  },
  "imports": {
    "#types/*": "./dist/types/*.js",
    "#plugins/*": "./dist/plugins/*.js",
    "#routes/*": "./dist/routes/*.js",
    "#src/*": "./dist/*.js",
    "#test/*": "./test/*.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/autoload": "^6.0.0",
    "@fastify/cors": "^11.4.1",
    "@fastify/sensible": "^6.0.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@supabase/supabase-js": "^2.116.0",
    "bcryptjs": "^3.0.3",
    "close-with-grace": "^2.5.0",
    "dotenv": "^18.0.0",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "nodemailer": "^10.0.13",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "@types/winston": "^2.4.4",
    "c8": "^12.0.0",
    "chai": "^6.2.2",
    "concurrently": "^10.0.1",
    "eslint": "^10.10.0",
    "fastify-tsconfig": "^3.0.0",
    "mocha": "^11.8.0",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "ts-mocha": "^11.1.0",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.0"
  }
}